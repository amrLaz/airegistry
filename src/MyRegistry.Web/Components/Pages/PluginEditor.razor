@page "/plugins/{Id:guid}"
@inject PluginService Plugins
@inject Localizer L
@inject IAuthProvider Auth
@inject NavigationManager Nav
@inject ISnackbar Snack
@implements IDisposable

<PageTitle>@L["plugins"] · MyRegistry</PageTitle>
<MudStack Spacing="3">
    <MudLink Href="/plugins" Color="Color.Secondary">← @L["plugins"]</MudLink>

    @if (_draft is null)
    {
        <MudAlert Severity="Severity.Warning">@(_forbidden ? L["forbidden"] : L["not_found"])</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h4" Component="@("h1")" Style="font-weight:800">@(string.IsNullOrEmpty(_name) ? L["plugins_new"] : _name)</MudText>

        @if (_draft.PublishedVersionId is not null)
        {
            <MudAlert Severity="Severity.Success">@L["plugins_published"] — <MudLink Href="@($"/artifact/{_draft.PublishedVersionId}")">v@(_draft.Version)</MudLink></MudAlert>
        }

        <MudPaper Class="pa-4">
            <MudGrid Spacing="2">
                <MudItem xs="6" sm="3"><MudTextField @bind-Value="_ns" Label="@L["namespace"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="6" sm="5"><MudTextField @bind-Value="_name" Label="@L["name"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_version" Label="@L["version"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_description" Label="@L["description"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">@L["plugins_components"]</MudText>
            @if (_components.Count == 0) { <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-2">@L["plugins_none"]</MudText> }
            @foreach (var c in _components)
            {
                var cc = c;
                var update = _draft.Updates.FirstOrDefault(u => u.Slug == cc.Slug);
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="py-2" Style="border-bottom:1px dashed rgba(128,128,128,.3)">
                    <div>
                        <MudChip T="string" Size="Size.Small" Style="@($"background:{TypeStyle.Color(cc.Type)};color:#fff")">@TypeStyle.Label(cc.Type, L.Lang == "fr")</MudChip>
                        <b>@cc.Slug</b>
                    </div>
                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                        @if (update is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" OnClick="() => SetVersion(cc.Slug, update.Latest)">@L["plugins_update"] : v@(update.Latest)</MudChip>
                        }
                        <MudSelect T="string" Value="cc.Version" ValueChanged="v => SetVersion(cc.Slug, v)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:140px" aria-label="@cc.Slug">
                            @foreach (var v in VersionsFor(cc)) { <MudSelectItem Value="v">v@(v)</MudSelectItem> }
                        </MudSelect>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => Remove(cc.Slug)" aria-label="@L["delete"]" />
                    </MudStack>
                </MudStack>
            }
        </MudPaper>

        @foreach (var e in _errors) { <MudAlert Severity="Severity.Error" Dense><code>@e.Code</code> @e.Message</MudAlert> }

        <MudStack Row Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Outlined" OnClick="Save">@L["save"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PublishDraft">@L["publish"]</MudButton>
            <MudButton Variant="Variant.Text" Href="@($"/api/plugins/drafts/{Id}/export")">@L["plugins_export"]</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Delete">@L["delete"]</MudButton>
        </MudStack>

        <MudPaper Class="pa-4">
            <MudTextField @bind-Value="_q" Immediate DebounceInterval="250" OnDebounceIntervalElapsed="Search" Placeholder="@L["plugins_search"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />
            @foreach (var r in _results.Where(r => !_components.Any(c => c.Slug == r.Slug)))
            {
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-1" Style="border-bottom:1px dashed rgba(128,128,128,.3)">
                    <div>
                        <MudChip T="string" Size="Size.Small" Style="@($"background:{TypeStyle.Color(r.Type)};color:#fff")">@TypeStyle.Label(r.Type, L.Lang == "fr")</MudChip>
                        <b>@r.Slug</b> <span style="font-family:monospace">v@(r.Versions[0])</span>
                        <MudText Typo="Typo.caption">@r.Description</MudText>
                    </div>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => Add(r)">@L["plugins_add"]</MudButton>
                </MudStack>
            }
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter] public Guid Id { get; set; }
    private DraftDto? _draft;
    private bool _forbidden;
    private string _ns = "", _name = "", _version = "", _description = "", _q = "";
    private List<ComponentRef> _components = [];
    private IReadOnlyList<ComponentChoice> _results = [];
    private Dictionary<string, IReadOnlyList<string>> _known = new();
    private IReadOnlyList<MyRegistry.Application.Rules.Issue> _errors = [];
    private CurrentUser _user = default!;

    protected override async Task OnInitializedAsync()
    {
        _user = Auth.GetCurrentUser();
        L.Changed += OnChanged;
        var r = await Plugins.GetDraftAsync(Id, _user);
        _forbidden = r.Forbidden;
        if (r.Draft is null) return;
        Load(r.Draft);
        await Search();
    }

    private void Load(DraftDto d)
    {
        _draft = d; _ns = d.Namespace; _name = d.Name; _version = d.Version ?? ""; _description = d.Description ?? ""; _components = d.Components.ToList();
    }

    private IReadOnlyList<string> VersionsFor(ComponentRef c) =>
        (_known.TryGetValue(c.Slug, out var vs) ? vs : []).Concat([c.Version]).Distinct().ToList();

    private async Task Search()
    {
        _results = await Plugins.SearchComponentsAsync(null, _q);
        foreach (var r in _results) _known[r.Slug] = r.Versions;
    }

    private void Add(ComponentChoice r) => _components.Add(new ComponentRef(r.Type, r.Slug, r.Versions[0]));
    private void Remove(string slug) => _components.RemoveAll(c => c.Slug == slug);
    private void SetVersion(string slug, string v) => _components = _components.Select(c => c.Slug == slug ? c with { Version = v } : c).ToList();

    private async Task<bool> Persist()
    {
        var r = await Plugins.SaveDraftAsync(Id, new DraftInput(_ns, _name, _description, string.IsNullOrWhiteSpace(_version) ? null : _version, _components), _user);
        _errors = r.Errors;
        if (r.Draft is not null) Load(r.Draft);
        return r.Draft is not null;
    }

    private async Task Save() { if (await Persist()) Snack.Add(L["saved"], Severity.Success); }

    private async Task PublishDraft()
    {
        if (!await Persist()) return;
        var r = await Plugins.PublishDraftAsync(Id, _user);
        _errors = r.Errors;
        if (r.Import is { Success: true }) { Snack.Add(L["plugins_published"], Severity.Success); Nav.NavigateTo($"/artifact/{r.Import.VersionId}"); }
        else if (r.Import?.CanonicalName is { } canon) Snack.Add($"{L["canonical"]} : {canon}", Severity.Info);
    }

    private async Task Delete() { await Plugins.DeleteDraftAsync(Id, _user); Nav.NavigateTo("/plugins"); }
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnChanged;
}
