@page "/"
@inject CatalogService Svc
@inject Localizer L
@inject IAuthProvider Auth
@implements IDisposable

<PageTitle>MyRegistry</PageTitle>

<MudStack Spacing="4">
    @if (IsHome)
    {
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">@L["home_latest"]</MudText>
            @if (_items.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">@L["empty"]</MudAlert>
            }
            else
            {
                <MudGrid Spacing="3" Class="mt-1">
                    @foreach (var i in _items.Take(3))
                    {
                        <MudItem xs="12" md="4">
                            <MudLink Href="@($"/artifact/{i.Id}")" Underline="Underline.None" Color="Color.Inherit">
                                <MudPaper Outlined Class="pa-4" Style="height:100%">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="@($"border-color:{TypeStyle.Color(i.Type)};color:{TypeStyle.Color(i.Type)};font-family:monospace;text-transform:uppercase")">@TypeStyle.Label(i.Type, L.Lang == "fr")</MudChip>
                                    <MudText Typo="Typo.h6" Class="mt-2" Style="font-weight:700">@i.Namespace/@i.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">v@(i.Version)</MudText>
                                </MudPaper>
                            </MudLink>
                        </MudItem>
                    }
                </MudGrid>
            }
        </div>

        <MudPaper Outlined Class="pa-6 pa-md-8">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2">
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Primary">@L["home_categories"]</MudText>
                    <MudText Typo="Typo.h5" Component="@("h1")" Style="font-weight:700">@L["home_choose"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["home_hint"] · @_total</MudText>
                </div>
            </MudStack>
            <MudGrid Spacing="3" Class="mt-4">
                @foreach (var t in HomeOrder)
                {
                    var tt = t;
                    <MudItem xs="12" sm="6" md="4">
                        <MudLink Href="@($"/?type={tt}")" Underline="Underline.None" Color="Color.Inherit">
                            <MudPaper Outlined Class="pa-5 home-card" Style="@($"height:100%;border-top:4px solid {TypeStyle.Color(tt)}")">
                                <MudText Typo="Typo.h6" Style="font-weight:700">@TypeStyle.Plural(tt, L.Lang == "fr")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-2">@L[$"desc_{tt}"]</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Primary" Style="font-weight:600">@L["explore"] →</MudText>
                            </MudPaper>
                        </MudLink>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }
    else
    {
        var fr = L.Lang == "fr";
        <div>
            <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                <MudButton Href="/" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Size="Size.Small">@L["back"]</MudButton>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Reload" aria-label="@L["refresh"]" />
            </MudStack>
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Wrap="Wrap.Wrap" Spacing="3">
                <div style="flex:1 1 420px;min-width:0">
                    <MudText Typo="Typo.overline" Color="Color.Primary">@L["catalog_overline"]</MudText>
                    <MudText Typo="Typo.h3" Component="@("h1")" Style="font-weight:800;letter-spacing:-0.03em">
                        @if (_type is { } ct) { <MudIcon Icon="@TypeStyle.Icon(ct)" Size="Size.Large" Style="@($"color:{TypeStyle.Color(ct)};vertical-align:-6px;margin-right:8px")" /> }
                        @(_type is { } ct2 ? TypeStyle.Plural(ct2, fr) : L["catalog"])
                    </MudText>
                    @if (_type is { } ct3) { <MudText Color="Color.Secondary" Class="mt-1">@L[$"desc_{ct3}"]</MudText> }
                    else if (!string.IsNullOrWhiteSpace(_q)) { <MudText Color="Color.Secondary">« @_q »</MudText> }
                </div>
                <MudStack AlignItems="AlignItems.End" Spacing="2">
                    @if (_user.Role >= Role.Publisher)
                    {
                        <MudButton Href="@(_type == ArtifactType.Plugin ? "/plugins" : _type is { } nt ? $"/publish?type={nt}" : "/publish")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Style="border-radius:999px">
                            @(_type is { } nt2 ? NewLabel(nt2, fr) : L["publish"])
                        </MudButton>
                    }
                    <div style="text-align:right">
                        <MudText Typo="Typo.h2" Style="font-weight:800;line-height:1">@_total</MudText>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@L["indexed"]</MudText>
                    </div>
                </MudStack>
            </MudStack>
        </div>
        <MudDivider />

        <MudStack Row Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
            <div style="flex:2 1 260px;min-width:0">
                <MudTextField @bind-Value="_filter" Immediate DebounceInterval="250" OnDebounceIntervalElapsed="Reload" Placeholder="@L["name_author"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" aria-label="@L["name_author"]" />
            </div>
            <MudSelect T="string" Value="_tag" ValueChanged="SetTag" Label="@L["tags_filter"]" Placeholder="@L["all_tags"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable Style="flex:1 1 180px;min-width:160px">
                @foreach (var t in _allTags) { <MudSelectItem T="string" Value="t">#@t</MudSelectItem> }
            </MudSelect>
            <MudChip T="string" Variant="@(_origin is null ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="() => SetOrigin(null)">@L["all_sources"]</MudChip>
            <MudChip T="string" Variant="@(_origin == MyRegistry.Domain.Origin.Internal ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="() => SetOrigin(MyRegistry.Domain.Origin.Internal)">@L["feed_internal"]</MudChip>
            <MudChip T="string" Variant="@(_origin == MyRegistry.Domain.Origin.External ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="() => SetOrigin(MyRegistry.Domain.Origin.External)">@L["feed_external"]</MudChip>
        </MudStack>

        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudText Color="Color.Secondary">@_items.Count @L["artifacts_count"]</MudText>
            <MudStack Row Spacing="2">
                @if (_user.Role >= Role.Moderator)
                {
                    <MudSelect T="VersionStatus?" Value="_status" ValueChanged="SetStatus" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" Label="@L["status"]" Clearable>
                        @foreach (var st in Enum.GetValues<VersionStatus>()) { <MudSelectItem T="VersionStatus?" Value="st">@st</MudSelectItem> }
                    </MudSelect>
                }
                <MudSelect T="string" Value="_sort" ValueChanged="SortChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:200px" Label="@L["sort_by"]">
                    <MudSelectItem Value="@("recent")">@L["sort_recent"]</MudSelectItem>
                    <MudSelectItem Value="@("popular")">@L["sort_popular"]</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudStack>

        @if (_items.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@L["empty"]</MudAlert>
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var i in _items)
                {
                    <MudItem xs="12" md="6" lg="4">
                        <MudPaper Outlined Class="pa-5" Style="height:100%;display:flex;flex-direction:column;gap:8px;position:relative">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="@($"border-color:{TypeStyle.Color(i.Type)};color:{TypeStyle.Color(i.Type)};font-family:monospace;text-transform:uppercase")">@TypeStyle.Label(i.Type, fr)</MudChip>
                                @if (i.Origin == MyRegistry.Domain.Origin.External) { <MudTooltip Text="@L["feed_external"]"><MudIcon Icon="@Icons.Material.Filled.RssFeed" Size="Size.Small" Color="Color.Warning" /></MudTooltip> }
                                <MudTooltip Text="@i.Status.ToString()"><MudIcon Icon="@(i.Quarantined ? Icons.Material.Filled.GppBad : Icons.Material.Filled.VerifiedUser)" Size="Size.Small" Color="@(i.Quarantined ? Color.Error : TypeStyle.StatusColor(i.Status))" /></MudTooltip>
                                <MudSpacer />
                                <MudText Typo="Typo.body2">▲ @i.Votes</MudText>
                            </MudStack>
                            <MudLink Href="@($"/artifact/{i.Id}")" Underline="Underline.None" Color="Color.Inherit">
                                <MudText Typo="Typo.h5" Style="font-weight:700;letter-spacing:-0.02em;overflow-wrap:anywhere">@i.Namespace/@i.Name</MudText>
                            </MudLink>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="flex:1;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden">@i.Description</MudText>
                            @if (i.Tags.Length > 0)
                            {
                                <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                                    @foreach (var tag in i.Tags) { <MudChip T="string" Size="Size.Small" OnClick="() => SetTag(tag)">#@tag</MudChip> }
                                </MudStack>
                            }
                            <MudText Typo="Typo.caption" Style="font-family:monospace">v@(i.Version)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-family:monospace">@L["updated_on"] @i.CreatedAt.ToString("dd/MM/yyyy") @L["updated_by"] @i.Author</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    }
</MudStack>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? QueryQ { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? QueryType { get; set; }

    private static readonly ArtifactType[] HomeOrder =
        [ArtifactType.Agent, ArtifactType.Prompt, ArtifactType.Skill, ArtifactType.Hook, ArtifactType.Plugin, ArtifactType.McpServer];
    private bool IsHome => string.IsNullOrWhiteSpace(_q) && _type is null && _tag is null && _status is null;
    private List<CatalogItem> _items = [];
    private int _total;
    private string? _q;
    private string? _filter;
    private MyRegistry.Domain.Origin? _origin;
    private List<string> _allTags = [];
    private string _sort = "recent";
    private ArtifactType? _type;
    private string? _tag;
    private VersionStatus? _status;
    private CurrentUser _user = default!;

    protected override async Task OnInitializedAsync()
    {
        _user = Auth.GetCurrentUser();
        L.Changed += OnChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        _q = QueryQ;
        _type = Enum.TryParse<ArtifactType>(QueryType, true, out var t) ? t : null;
        await Reload();
    }

    private async Task Reload()
    {
        var mod = _user.Role >= Role.Moderator;
        var query = string.IsNullOrWhiteSpace(_filter) ? _q : _filter;
        var page = await Svc.ListAsync(_type, _status, _tag, query, _sort, mod, 1, 60, _origin);
        _items = page.Items.ToList();
        _total = page.Total;
        var scope = await Svc.ListAsync(_type, null, null, null, "recent", mod, 1, 100);
        _allTags = scope.Items.SelectMany(i => i.Tags).Distinct().OrderBy(t => t).ToList();
        if (IsHome || _type is not null) _total = scope.Total;
    }

    private Task SetOrigin(MyRegistry.Domain.Origin? o) { _origin = o; return Reload(); }
    private static string NewLabel(ArtifactType t, bool fr) =>
        fr ? (t == ArtifactType.Agent ? "Nouvel Agent" : $"Nouveau {TypeStyle.Label(t, true)}") : $"New {TypeStyle.Label(t, false)}";
    private Task SetTag(string? t) { _tag = t; return Reload(); }
    private Task SetStatus(VersionStatus? st) { _status = st; return Reload(); }
    private Task SetType(ArtifactType? t) { _type = t; return Reload(); }
    private Task SortChanged(string s) { _sort = s; return Reload(); }
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnChanged;
}
