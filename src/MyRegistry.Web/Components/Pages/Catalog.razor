@page "/"
@inject CatalogService Svc
@inject Localizer L
@inject IAuthProvider Auth
@implements IDisposable

<PageTitle>MyRegistry</PageTitle>

<MudStack Spacing="4">
    @if (IsHome)
    {
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">@L["home_latest"]</MudText>
            @if (_items.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">@L["empty"]</MudAlert>
            }
            else
            {
                <MudGrid Spacing="3" Class="mt-1">
                    @foreach (var i in _items.Take(3))
                    {
                        <MudItem xs="12" md="4">
                            <MudLink Href="@($"/artifact/{i.Id}")" Underline="Underline.None" Color="Color.Inherit">
                                <MudPaper Outlined Class="pa-4" Style="height:100%">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="@($"border-color:{TypeStyle.Color(i.Type)};color:{TypeStyle.Color(i.Type)};font-family:monospace;text-transform:uppercase")">@TypeStyle.Label(i.Type, L.Lang == "fr")</MudChip>
                                    <MudText Typo="Typo.h6" Class="mt-2" Style="font-weight:700">@i.Namespace/@i.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">v@(i.Version)</MudText>
                                </MudPaper>
                            </MudLink>
                        </MudItem>
                    }
                </MudGrid>
            }
        </div>

        <MudPaper Outlined Class="pa-6 pa-md-8">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2">
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Primary">@L["home_categories"]</MudText>
                    <MudText Typo="Typo.h5" Component="@("h1")" Style="font-weight:700">@L["home_choose"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["home_hint"] · @_total</MudText>
                </div>
            </MudStack>
            <MudGrid Spacing="3" Class="mt-4">
                @foreach (var t in HomeOrder)
                {
                    var tt = t;
                    <MudItem xs="12" sm="6" md="4">
                        <MudLink Href="@($"/?type={tt}")" Underline="Underline.None" Color="Color.Inherit">
                            <MudPaper Outlined Class="pa-5 home-card" Style="@($"height:100%;border-top:4px solid {TypeStyle.Color(tt)}")">
                                <MudText Typo="Typo.h6" Style="font-weight:700">@TypeStyle.Plural(tt, L.Lang == "fr")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-2">@L[$"desc_{tt}"]</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Primary" Style="font-weight:600">@L["explore"] →</MudText>
                            </MudPaper>
                        </MudLink>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }
    else
    {
    <div>
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/" aria-label="@L["back_home"]" />
            <MudText Typo="Typo.h4" Component="@("h1")" Style="font-weight:800;letter-spacing:-0.02em">
                @(_type is { } ct ? TypeStyle.Plural(ct, L.Lang == "fr") : L["catalog"])@(string.IsNullOrWhiteSpace(_q) ? "" : $" · « {_q} »")
            </MudText>
        </MudStack>
        <MudText Color="Color.Secondary">@_total</MudText>
    </div>

    <MudStack Row Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
        <MudSelect T="string" Value="_sort" ValueChanged="SortChanged" Variant="Variant.Outlined" Style="max-width:200px" Label="Tri">
            <MudSelectItem Value="@("recent")">@L["sort_recent"]</MudSelectItem>
            <MudSelectItem Value="@("popular")">@L["sort_popular"]</MudSelectItem>
        </MudSelect>
        @if (_user.Role >= Role.Moderator)
        {
            <MudSelect T="VersionStatus?" Value="_status" ValueChanged="SetStatus" Variant="Variant.Outlined" Style="max-width:200px" Label="@L["status"]" Clearable>
                @foreach (var st in Enum.GetValues<VersionStatus>()) { <MudSelectItem T="VersionStatus?" Value="st">@st</MudSelectItem> }
            </MudSelect>
        }
    </MudStack>

    <MudStack Row Wrap="Wrap.Wrap" Spacing="2">
        <MudChip T="string" Color="Color.Primary" Variant="@(_type is null ? Variant.Filled : Variant.Outlined)" OnClick="() => SetType(null)">@L["all"]</MudChip>
        @foreach (var t in Enum.GetValues<ArtifactType>())
        {
            var tt = t;
            <MudChip T="string" Variant="@(_type == tt ? Variant.Filled : Variant.Outlined)" OnClick="() => SetType(tt)"
                     Style="@($"border-color:{TypeStyle.Color(tt)};" + (_type == tt ? $"background:{TypeStyle.Color(tt)};color:#fff" : ""))">
                @TypeStyle.Label(tt, L.Lang == "fr")
            </MudChip>
        }
    </MudStack>

    @if (_tag is not null)
    {
        <MudChip T="string" Color="Color.Primary" OnClose="() => SetTag(null)">@L["tag_filter"] : #@_tag</MudChip>
    }

    @if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@L["empty"]</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var i in _items)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudLink Href="@($"/artifact/{i.Id}")" Underline="Underline.None" Color="Color.Inherit">
                        <MudPaper Elevation="1" Style="overflow:hidden;height:100%">
                            <div style="@($"background:{TypeStyle.Color(i.Type)};color:#fff;padding:10px 16px;display:flex;justify-content:space-between;font-family:monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase")">
                                <span>@TypeStyle.Label(i.Type, L.Lang == "fr")</span><span style="text-transform:none">v@(i.Version)</span>
                            </div>
                            <div class="pa-4">
                                <MudText Typo="Typo.caption" Style="font-family:monospace">@i.Namespace/</MudText>
                                <MudText Typo="Typo.h5" Style="font-weight:800;letter-spacing:-0.02em;margin-top:-4px">@i.Name</MudText>
                                <MudText Typo="Typo.body2" Class="my-2">@i.Description</MudText>
                                <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                                    @foreach (var tag in i.Tags) { <MudChip T="string" Size="Size.Small" OnClick="() => SetTag(tag)">#@tag</MudChip> }
                                </MudStack>
                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2">▲ @i.Votes</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@TypeStyle.StatusColor(i.Status)">@i.Status</MudChip>
                                </MudStack>
                            </div>
                        </MudPaper>
                    </MudLink>
                </MudItem>
            }
        </MudGrid>
    }
    }
</MudStack>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? QueryQ { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? QueryType { get; set; }

    private static readonly ArtifactType[] HomeOrder =
        [ArtifactType.Agent, ArtifactType.Prompt, ArtifactType.Skill, ArtifactType.Hook, ArtifactType.Plugin, ArtifactType.McpServer];
    private bool IsHome => string.IsNullOrWhiteSpace(_q) && _type is null && _tag is null && _status is null;
    private List<CatalogItem> _items = [];
    private int _total;
    private string? _q;
    private string _sort = "recent";
    private ArtifactType? _type;
    private string? _tag;
    private VersionStatus? _status;
    private CurrentUser _user = default!;

    protected override async Task OnInitializedAsync()
    {
        _user = Auth.GetCurrentUser();
        L.Changed += OnChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        _q = QueryQ;
        _type = Enum.TryParse<ArtifactType>(QueryType, true, out var t) ? t : null;
        await Reload();
    }

    private async Task Reload()
    {
        var page = await Svc.ListAsync(_type, _status, _tag, _q, _sort, _user.Role >= Role.Moderator, 1, 60);
        _items = page.Items.ToList();
        _total = page.Total;
    }

    private Task SetTag(string? t) { _tag = t; return Reload(); }
    private Task SetStatus(VersionStatus? st) { _status = st; return Reload(); }
    private Task SetType(ArtifactType? t) { _type = t; return Reload(); }
    private Task SortChanged(string s) { _sort = s; return Reload(); }
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnChanged;
}
