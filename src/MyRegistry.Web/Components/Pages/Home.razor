@page "/"
@inject Localizer L
@inject IAuthProvider Auth
@implements IDisposable

<PageTitle>MyRegistry</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h3" Component="@("h1")">@L["welcome"] MyRegistry</MudText>
    <MudText Typo="Typo.subtitle1">@L["tagline"]</MudText>
    <MudPaper Class="pa-4">
        <MudText>@L["signedin"] <b>@_user.Email</b> · @L["role"] : <b>@_user.Role</b></MudText>
    </MudPaper>
    <MudAlert Severity="Severity.Info">@L["catalog"] : @L["soon"]</MudAlert>
</MudStack>

@code {
    private CurrentUser _user = default!;

    protected override void OnInitialized()
    {
        _user = Auth.GetCurrentUser();
        L.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnChanged;
}
