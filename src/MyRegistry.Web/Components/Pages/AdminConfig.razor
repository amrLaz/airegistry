@page "/admin/config"
@inject SettingsService Settings
@inject SnapshotService Snapshots
@inject SettingsCache Cache
@inject Localizer L
@inject IAuthProvider Auth
@inject ISnackbar Snack
@implements IDisposable

<PageTitle>@L["config"] · MyRegistry</PageTitle>
<MudText Typo="Typo.h4" Component="@("h1")" Style="font-weight:800" Class="mb-2">@L["config"]</MudText>
<AdminNav Current="/admin/config" />

@if (_user.Role < Role.Admin)
{
    <MudAlert Severity="Severity.Warning">@L["forbidden"]</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Style="max-width:640px">
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_title" Label="@L["config_title"]" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_ns" Label="@L["config_ns"]" Variant="Variant.Outlined" HelperText="2–32, a-z 0-9 -" />
            <MudTextField @bind-Value="_url" Label="@L["config_url"]" Variant="Variant.Outlined" Placeholder="https://registry.example.com" />
            <MudTextField @bind-Value="_repo" Label="@L["config_repo"]" Variant="Variant.Outlined" Placeholder="file:///var/lib/myregistry/marketplace" />
            @foreach (var e in _errors) { <MudAlert Severity="Severity.Error" Dense><code>@e.Code</code> @e.Message</MudAlert> }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@L["save"]</MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mt-3" Style="max-width:640px">
        <MudText Typo="Typo.h6">@L["snapshot"]</MudText>
        <MudText Typo="Typo.body2" Class="my-2">
            @L["snapshot_last"] : @(_status?.LastAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
            @if (_status?.LastCommit is { Length: > 0 } c) { <span style="font-family:monospace"> · @c[..Math.Min(7, c.Length)]</span> }
        </MudText>
        @foreach (var e in _snapErrors) { <MudAlert Severity="Severity.Error" Dense Class="mb-2"><code>@e.Code</code> @e.Message</MudAlert> }
        <MudButton Variant="Variant.Outlined" OnClick="PublishSnapshot" Disabled="_busy">@L["snapshot_publish"]</MudButton>
    </MudPaper>
}

@code {
    private string _title = "", _ns = "", _url = "", _repo = "";
    private SnapshotStatus? _status;
    private bool _busy;
    private IReadOnlyList<MyRegistry.Application.Rules.Issue> _snapErrors = [];
    private IReadOnlyList<MyRegistry.Application.Rules.Issue> _errors = [];
    private CurrentUser _user = default!;

    protected override async Task OnInitializedAsync()
    {
        _user = Auth.GetCurrentUser();
        L.Changed += OnChanged;
        if (_user.Role < Role.Admin) return;
        var s = await Settings.GetAllAsync();
        _title = s.GetValueOrDefault(SettingKeys.Title, ""); _ns = s.GetValueOrDefault(SettingKeys.DefaultNamespace, ""); _url = s.GetValueOrDefault(SettingKeys.PublicUrl, ""); _repo = s.GetValueOrDefault(SettingKeys.MarketplaceRepo, "");
        _status = await Snapshots.StatusAsync();
    }

    private async Task Save()
    {
        _errors = await Settings.UpdateAsync(new Dictionary<string, string>
        { [SettingKeys.Title] = _title, [SettingKeys.DefaultNamespace] = _ns, [SettingKeys.PublicUrl] = _url, [SettingKeys.MarketplaceRepo] = _repo }, _user.Email);
        Cache.Invalidate();
        if (_errors.Count == 0) Snack.Add(L["saved"], Severity.Success);
    }

    private async Task PublishSnapshot()
    {
        _busy = true;
        var r = await Snapshots.PublishAsync(_user.Email);
        _snapErrors = r.Errors;
        if (r.Errors.Count == 0) Snack.Add(r.Published ? L["snapshot_done"] : L["snapshot_unchanged"], Severity.Success);
        _status = await Snapshots.StatusAsync();
        _busy = false;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnChanged;
}
