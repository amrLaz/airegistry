@page "/artifact/{Id:guid}"
@inject CatalogService Svc
@inject CommunityService Community
@inject ISnackbar Snack
@inject Localizer L
@inject IAuthProvider Auth
@implements IDisposable

<MudStack Spacing="4">
    <MudLink Href="/" Color="Color.Secondary">← @L["back"]</MudLink>

    @if (_v is null)
    {
        <MudAlert Severity="Severity.Warning">@L["not_found"]</MudAlert>
    }
    else
    {
        <PageTitle>@_v.Artifact.Name · MyRegistry</PageTitle>
        <MudPaper Style="background:#10211C;color:#E8EFE6;padding:32px;border-radius:24px">
            <MudStack Spacing="2">
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudChip T="string" Style="@($"background:{TypeStyle.Color(_v.Artifact.Type)};color:#fff")">@TypeStyle.Label(_v.Artifact.Type, L.Lang == "fr")</MudChip>
                    <MudChip T="string" Color="@TypeStyle.StatusColor(_v.Status)">@_v.Status</MudChip>
                    @if (_v.Quarantined) { <MudChip T="string" Color="Color.Error">@L["quarantine"]</MudChip> }
                </MudStack>
                <MudText Typo="Typo.caption" Style="font-family:monospace;color:#8DA396">@_v.Artifact.Namespace/</MudText>
                <MudText Typo="Typo.h2" Component="@("h1")" Style="font-weight:800;letter-spacing:-0.03em;margin-top:-8px">@_v.Artifact.Name <span style="font-size:.4em;font-family:monospace;color:#C6F24E">v@(_v.Version)</span></MudText>
                <MudText>@_v.Description</MudText>
                <div style="font-family:monospace;background:#0A1612;border:1px solid #2B4339;border-radius:12px;padding:14px 16px;color:#C6F24E;overflow-x:auto;white-space:nowrap">
                    $ myregistry add @_v.Artifact.Name@@@_v.Version
                </div>
                <MudStack Row Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Href="@($"/api/catalog/{_v.Id}/download")" Variant="Variant.Filled" Style="background:#C6F24E;color:#10211C">@L["download"]</MudButton>
                    <MudButton OnClick="Vote" Variant="Variant.Outlined" Style="color:#E8EFE6;border-color:#2B4339">▲ @_votes</MudButton>
                    @if (_user.Role >= Role.Moderator && _v.Quarantined)
                    {
                        <MudButton OnClick="ReleaseQuarantine" Color="Color.Error" Variant="Variant.Outlined">@L["release"]</MudButton>
                    }
                    @if (_user.Role >= Role.Moderator && _v.Status != VersionStatus.Approved)
                    {
                        <MudButton OnClick="@(() => SetStatus(VersionStatus.Approved))" Color="Color.Success" Variant="Variant.Filled">@L["approve"]</MudButton>
                    }
                    @if (_user.Role >= Role.Moderator && _v.Status == VersionStatus.Approved)
                    {
                        <MudButton OnClick="@(() => SetStatus(VersionStatus.Deprecated))" Color="Color.Warning" Variant="Variant.Outlined">@L["deprecate"]</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4 mb-3">
                    <MudText Typo="Typo.h6">@L["files"]</MudText>
                    @foreach (var f in _v.Files.OrderBy(f => f.Path))
                    {
                        <div style="display:flex;justify-content:space-between;border-top:1px dashed #CBD5CC;padding:10px 0;font-family:monospace;font-size:14px">
                            <span style="overflow-wrap:anywhere">@f.Path</span><span>@FormatSize(f.Content.Length)</span>
                        </div>
                    }
                </MudPaper>
                <MudPaper Class="pa-4 mb-3">
                    <MudText Typo="Typo.h6">@L["content_tab"]</MudText>
                    <MudSelect T="string" @bind-Value="_selectedFile" Variant="Variant.Outlined" Dense Class="mb-2" aria-label="@L["files"]">
                        @foreach (var f in _v.Files.Where(f => !f.IsBinary).OrderBy(f => f.Path)) { <MudSelectItem Value="@f.Path">@f.Path</MudSelectItem> }
                    </MudSelect>
                    <pre style="margin:0;background:rgba(128,128,128,.12);border-radius:8px;padding:12px;overflow:auto;max-height:360px;font-size:13px">@SelectedText()</pre>
                </MudPaper>
                <MudPaper Class="pa-4 mb-3">
                    <MudText Typo="Typo.h6">@L["exports"]</MudText>
                    <MudStack Row Wrap="Wrap.Wrap" Spacing="2" Class="mt-2">
                        <MudButton Href="@($"/api/catalog/{_v.Id}/export/cursorrules")" Target="_blank" Variant="Variant.Outlined">@L["export_cursor"]</MudButton>
                        @if (_v.Artifact.Type == ArtifactType.McpServer)
                        {
                            <MudButton Href="@($"/api/catalog/{_v.Id}/export/claude-desktop")" Target="_blank" Variant="Variant.Outlined">@L["export_claude"]</MudButton>
                        }
                        <MudButton Href="@($"/api/catalog/{_v.Id}/audit-prompt")" Target="_blank" Variant="Variant.Outlined">@L["export_audit"]</MudButton>
                    </MudStack>
                </MudPaper>
                <MudPaper Class="pa-4 mb-3">
                    <MudText Typo="Typo.h6">@L["history"]</MudText>
                    @foreach (var h in _v.History.OrderBy(h => h.At))
                    {
                        <MudText Typo="Typo.body2">@h.At.ToString("yyyy-MM-dd HH:mm") · @(h.From?.ToString() ?? "—") → <b>@h.To</b> · @h.UserId @(h.Note is null ? "" : $"· {h.Note}")</MudText>
                    }
                </MudPaper>
                            <MudPaper Class="pa-4 mb-3">
                    <MudText Typo="Typo.h6">@L["comments"]</MudText>
                    @if (_comments.Count == 0) { <MudText Typo="Typo.body2" Color="Color.Secondary">@L["no_comments"]</MudText> }
                    @foreach (var c in _comments)
                    {
                        <div style="border-top:1px dashed rgba(128,128,128,.4);padding:8px 0">
                            <MudText Typo="Typo.caption">@c.UserId · @c.At.ToString("yyyy-MM-dd HH:mm")</MudText>
                            <MudText>@c.Body</MudText>
                        </div>
                    }
                    <MudTextField @bind-Value="_newComment" Label="@L["comment_add"]" Variant="Variant.Outlined" Lines="2" Class="mt-2" />
                    <MudButton OnClick="AddComment" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">@L["comment_send"]</MudButton>
                </MudPaper>
                </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 mb-3">
                    <MudText Typo="Typo.h6">@L["integrity"]</MudText>
                    <MudText Typo="Typo.caption">SHA-256</MudText>
                    <div style="font-family:monospace;font-size:12px;background:rgba(128,128,128,.12);border-radius:8px;padding:10px;overflow-wrap:anywhere">@_v.ContentHash</div>
                </MudPaper>
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6">@L["quality"]</MudText>
                    <MudText Typo="Typo.h2" Style="font-weight:800">@_v.QualityGrade</MudText>
                    <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var t in _v.Artifact.Tags) { <MudChip T="string" Size="Size.Small">#@t.Name</MudChip> }
                    </MudStack>
                </MudPaper>
                            <MudPaper Class="pa-4 mt-3">
                    <MudText Typo="Typo.h6">@L["report"]</MudText>
                    <MudSelect T="ReportReason" @bind-Value="_reason" Label="@L["report_reason"]" Variant="Variant.Outlined" Dense Class="my-2">
                        @foreach (var r in Enum.GetValues<ReportReason>()) { <MudSelectItem Value="r">@r</MudSelectItem> }
                    </MudSelect>
                    <MudTextField @bind-Value="_details" Label="@L["report_details"]" Variant="Variant.Outlined" Lines="2" />
                    <MudButton OnClick="SendReport" Variant="Variant.Outlined" Color="Color.Error" Class="mt-2">@L["report"]</MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    [Parameter] public Guid Id { get; set; }
    private ArtifactVersion? _v;
    private int _votes;
    private CurrentUser _user = default!;
    private string? _selectedFile;
    private List<CommentDto> _comments = [];
    private string _newComment = "";
    private string _details = "";
    private ReportReason _reason = ReportReason.BrokenArtifact;

    protected override async Task OnParametersSetAsync()
    {
        _user = Auth.GetCurrentUser();
        L.Changed += OnChanged;
        _v = await Svc.GetAsync(Id);
        if (_v is not null)
        {
            _votes = await Svc.VoteCountAsync(_v.ArtifactId);
            _selectedFile = (_v.Files.FirstOrDefault(f => f.Path == _v.MainFile) ?? _v.Files.FirstOrDefault(f => !f.IsBinary))?.Path;
            _comments = (await Community.CommentsAsync(Id))?.ToList() ?? [];
        }
    }

    private string SelectedText() =>
        _v?.Files.FirstOrDefault(f => f.Path == _selectedFile) is { IsBinary: false } f ? System.Text.Encoding.UTF8.GetString(f.Content) : "";

    private async Task AddComment()
    {
        if (await Community.AddCommentAsync(Id, _user.Email, _newComment) is { } c) { _comments.Add(c); _newComment = ""; }
    }

    private async Task SendReport()
    {
        var r = await Community.ReportAsync(Id, _reason, string.IsNullOrWhiteSpace(_details) ? null : _details, _user.Email);
        _details = "";
        Snack.Add(r is { Quarantined: true } ? L["report_quarantined"] : L["report_sent"], Severity.Success);
        _v = await Svc.GetAsync(Id);
    }

    private async Task ReleaseQuarantine()
    {
        await Community.ReleaseQuarantineAsync(Id, _user.Email);
        _v = await Svc.GetAsync(Id);
    }

    private async Task Vote()
    {
        if (_v is null) return;
        _votes = await Svc.ToggleVoteAsync(_v.Id, _user.Email) ?? _votes;
    }

    private async Task SetStatus(VersionStatus s)
    {
        await Svc.SetStatusAsync(Id, s, _user.Email, null);
        _v = await Svc.GetAsync(Id);
    }

    private static string FormatSize(int b) => b < 1024 ? $"{b} o" : $"{b / 1024.0:0.0} Ko";
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnChanged;
}
