@inherits LayoutComponentBase
@inject Localizer L
@implements IDisposable
@inject IAuthProvider Auth
@inject SettingsCache Settings

<MudThemeProvider @bind-IsDarkMode="_dark" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Transparent" Style="background:#10211C !important;color:#fff !important">
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit">
            <MudText Typo="Typo.h6" Style="font-weight:800;letter-spacing:-0.02em">
                <span style="background:#C6F24E;color:#10211C;border-radius:8px;padding:2px 8px;margin-right:8px">@(_title.Length > 0 ? char.ToUpperInvariant(_title[0]) : 'M')</span>@_title
            </MudText>
        </MudLink>
        <MudSpacer />
        @if (_user.Role >= Role.Moderator)
        {
            <MudButton Href="/admin" Color="Color.Inherit" Class="mr-1">@L["admin"]</MudButton>
        }
        @if (_user.Role >= Role.Publisher)
        {
            <MudButton Href="/plugins" Color="Color.Inherit" Class="mr-1">@L["plugins"]</MudButton>
        }
        <MudButton Href="/my" Color="Color.Inherit" Class="mr-1">@L["my_pubs"]</MudButton>
        <MudButton Href="/publish" Variant="Variant.Filled" Style="background:#C6F24E;color:#10211C" Class="mr-2">@L["publish"]</MudButton>
        <MudButton Color="Color.Inherit" OnClick="L.Toggle" aria-label="@L["lang"]">@(L.Lang == "fr" ? "EN" : "FR")</MudButton>
        <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="() => _dark = !_dark" aria-label="@L["theme"]" />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6 px-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _dark;
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#10211C", Secondary = "#4B6258", TextPrimary = "#10211C", TextSecondary = "#4B6258", PrimaryContrastText = "#FFFFFF", Background = "#EEF1EC", Surface = "#FFFFFF", AppbarBackground = "#10211C" },
        PaletteDark = new PaletteDark { Primary = "#C6F24E", PrimaryContrastText = "#10211C", Secondary = "#8DA396", TextPrimary = "#E8EFE6", TextSecondary = "#A9BBAE", Info = "#7DD3FC", Background = "#0A1612", Surface = "#10211C" },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "14px" },
    };

    private void OnChanged() => InvokeAsync(StateHasChanged);
    private CurrentUser _user = default!;
    private string _title = "MyRegistry";
    protected override async Task OnInitializedAsync() { _user = Auth.GetCurrentUser(); L.Changed += OnChanged; _title = await Settings.TitleAsync(); }
    public void Dispose() => L.Changed -= OnChanged;
}
