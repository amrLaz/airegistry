MYREGISTRY_DB_CONNECTION=Host=localhost;Port=5432;Database=myregistry;Username=myregistry;Password=myregistry
MYREGISTRY_PUBLIC_URL=http://localhost:8080
MYREGISTRY_AUTH_MODE=dev            # dev | oidc
MYREGISTRY_DEV_USER_EMAIL=dev@example.com
MYREGISTRY_DEV_USER_ROLE=Admin      # Reader|Publisher|Moderator|SecurityValidator|Admin
MYREGISTRY_STORAGE=local            # local | azureblob
MYREGISTRY_STORAGE_PATH=/data
# Phase 5
MYREGISTRY_GIT_AZDO_PAT=
MYREGISTRY_GIT_GITHUB_PAT=
# Phase 7 (OIDC)
MYREGISTRY_OIDC_AUTHORITY=
MYREGISTRY_OIDC_CLIENT_ID=
MYREGISTRY_OIDC_CLIENT_SECRET=
